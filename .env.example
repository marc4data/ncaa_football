# cfdb environment — KEY NAMES AND COMMENTS ONLY. NO VALUES, EVER.
#
# Copy to .env and fill it in.  .env is gitignored (.gitignore line 7), so like
# dbt/profiles.yml it is PER WORKING COPY and a `git pull` cannot correct it. This repo now
# has three working copies side by side — claude_code/, wt-drives/, cfdb_deploy/ — with
# three separate .env files, none visible to the others.
#
# This file exists because three keys (the CFDB_NOTEBOOK_* / CFDB_DROPLET_PG_ADDR set) once
# lived in exactly one clone's .env and nowhere else. That clone was deleted. A key that
# exists in one directory scheduled for deletion is precisely what an example file prevents.
#
# After filling this in:   python scripts/preflight_env.py

# ------------------------------------------------------------------ CFBD API ---
CFBD_API_KEY=

# ---------------------------------------------------------------- warehouse ---
# THE DROPLET'S PIPELINE POSTGRES. This is where dbt builds. There is no local warehouse —
# the laptop Postgres was dropped 2026-09-05 (R-296). See CLAUDE.md, "Environments".
#
# The warehouse publishes no host port on the droplet, so you reach it through an SSH
# local-forward that you open yourself:
#
#     scripts/warehouse_tunnel.sh          # leave it running in another terminal
#
# CFDB_WAREHOUSE_HOST is then the LOCAL end of that tunnel — your own machine — which is why
# it is an ordinary value and not a secret. The PORT IS DELIBERATELY NOT 5432: the preflight
# refuses loopback-on-5432 because that, exactly, is the database that was dropped.
CFDB_WAREHOUSE_HOST=
CFDB_WAREHOUSE_PORT=

# Warehouse credentials. Also used by src/ loaders (PG_HOST is set by compose inside
# Airflow, so these fall through to the tunnel only when you run a loader by hand).
PG_USER=
PG_PASSWORD=
PG_DB=

# ------------------------------------------------------------------- droplet ---
# Addressed by variable, never by a literal in a tracked file — see deploy/README.md. Not
# because an IP is secret, but because a literal in a repo that may go public is a complete
# map with no upside.
CFDB_DROPLET_HOST=           # root@<droplet>       — admin SSH, used by the tunnel script
CFDB_SITE_HOST=              # <hostname>           — the public site, behind Cloudflare Access
SERVING_SSH_HOST=            # root@<droplet>       — used by scripts/deploy_main.sh
SERVING_PUBLISH_HOST=        # cfdb_publish@<droplet> — the restricted publish identity
CFDB_PUBLISH_KEY=            # path to the publish private key; mounted read-only, never copied

# Read-only role the site connects as. SELECT and nothing else.
CFDB_READ_USER=
CFDB_READ_PASSWORD=

# --------------------------------------------------------------- notebooks ---
# R-319. These three lived in exactly one clone's .env and nowhere else until 2026-09-05.
#
# notebooks/cfdb_conn.py picks its backend from the first. `warehouse` is the droplet's
# pipeline Postgres (what dbt builds); `serving` is the droplet's published subset (what the
# site reads). THEY ARE DIFFERENT DATABASES AND THE ANSWERS DIFFER — the serving one carries
# only what has been published.
CFDB_NOTEBOOK_BACKEND=       # warehouse | serving | databricks
CFDB_REMOTE_PG_PORT=         # local end of the tunnel; must not be 5432
#
# RETIRED: CFDB_DROPLET_PG_ADDR. It pinned a Docker-assigned container IP (172.19.0.2),
# which is reassigned whenever the stack is recreated — after which the tunnel opens
# successfully against nothing, or against whatever now holds the address. Delete it from
# your .env. scripts/warehouse_tunnel.sh resolves the address at tunnel time instead, so
# there is nothing left to go stale.

# ------------------------------------------------------------------ Airflow ---
AIRFLOW_FERNET_KEY=          # python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AIRFLOW_JWT_SECRET=          # python -c "import secrets; print(secrets.token_hex(32))"
AIRFLOW_ADMIN_USER=
AIRFLOW_ADMIN_PASSWORD=

# ---------------------------------------------------------------- alerting ---
ALERT_SMTP_HOST=
ALERT_SMTP_PORT=
ALERT_SMTP_USER=
ALERT_SMTP_PASSWORD=
ALERT_EMAIL_FROM=
ALERT_EMAIL_TO=

# -------------------------------------------------------------- Databricks ---
# M4 target. Reached only via an explicit `--target databricks`, never as the default.
DATABRICKS_SERVER_HOSTNAME=
DATABRICKS_HTTP_PATH=
DATABRICKS_TOKEN=

# ------------------------------------------------------------------- Claude ---
ANTHROPIC_API_KEY=
